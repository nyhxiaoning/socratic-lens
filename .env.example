# 复制为 .env.local 后填入实际值

# OpenAI 兼容端点（不含 /chat/completions 后缀）
# 火山方舟 Ark 例子：https://ark.cn-beijing.volces.com/api/v3
# OpenAI 官方：https://api.openai.com/v1
# DeepSeek：https://api.deepseek.com/v1
LLM_BASE_URL=

LLM_API_KEY=

# 默认模型（teacher / learner / audit 共用），可被下面三个覆盖
LLM_MODEL=

# 可选：分别指定不同 purpose 的模型
# LLM_MODEL_TEACHER=
# LLM_MODEL_LEARNER=
# LLM_MODEL_AUDIT=

# 可选：单价（每 1000 token，¥），用来在 UI footer 累计"本次已花多少"
# 不填就显示 0，不影响任何功能
# LLM_PRICE_IN=0.001
# LLM_PRICE_OUT=0.002
# 也可以按 purpose 覆盖：LLM_PRICE_IN_COACH / LLM_PRICE_OUT_TEACHER 等
